<div id="<%= dom_id ability %>">
  <p>
    <strong>Name:</strong>
    <%= ability.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= ability.description %>
  </p>

  <p>
    <strong>Usage type:</strong>
    <%= ability.usage_type %>
  </p>

  <p>
    <strong>Default usage limit:</strong>
    <%= ability.default_usage_limit %>
  </p>

  <p>
    <strong>Default cooldown:</strong>
    <%= ability.default_cooldown %>
  </p>

</div>
