<div id="<%= dom_id ability_usage %>">
  <p>
    <strong>Tracker:</strong>
    <%= ability_usage.tracker_id %>
  </p>

  <p>
    <strong>Creature:</strong>
    <%= ability_usage.creature_id %>
  </p>

  <p>
    <strong>Ability:</strong>
    <%= ability_usage.ability_id %>
  </p>

  <p>
    <strong>Used at:</strong>
    <%= ability_usage.used_at %>
  </p>

  <p>
    <strong>Round used:</strong>
    <%= ability_usage.round_used %>
  </p>

  <p>
    <strong>Cooldown remaining:</strong>
    <%= ability_usage.cooldown_remaining %>
  </p>

</div>
