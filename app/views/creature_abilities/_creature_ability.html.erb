<div id="<%= dom_id creature_ability %>">
  <p>
    <strong>Creature:</strong>
    <%= creature_ability.creature_id %>
  </p>

  <p>
    <strong>Ability:</strong>
    <%= creature_ability.ability_id %>
  </p>

  <p>
    <strong>Usage limit:</strong>
    <%= creature_ability.usage_limit %>
  </p>

  <p>
    <strong>Cooldown rounds:</strong>
    <%= creature_ability.cooldown_rounds %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= creature_ability.notes %>
  </p>

</div>
