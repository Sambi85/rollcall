<%= form_with(model: creature_ability) do |form| %>
  <% if creature_ability.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(creature_ability.errors.count, "error") %> prohibited this creature_ability from being saved:</h2>

      <ul>
        <% creature_ability.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :creature_id, style: "display: block" %>
    <%= form.text_field :creature_id %>
  </div>

  <div>
    <%= form.label :ability_id, style: "display: block" %>
    <%= form.text_field :ability_id %>
  </div>

  <div>
    <%= form.label :usage_limit, style: "display: block" %>
    <%= form.number_field :usage_limit %>
  </div>

  <div>
    <%= form.label :cooldown_rounds, style: "display: block" %>
    <%= form.number_field :cooldown_rounds %>
  </div>

  <div>
    <%= form.label :notes, style: "display: block" %>
    <%= form.textarea :notes %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
