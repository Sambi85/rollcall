<%# _hp_controls.html.erb %>

<% if creature %>
  <div class="p-4 bg-gray-700 rounded-2xl text-white">
    <h2 class="text-lg font-bold mb-2"><%= creature.name %></h2>
    <p>Temp HP: <%= creature.temp_hp %></p>
    <p>Current HP: <%= creature.current_hp + creature.temp_hp  %></p>
    <p>Max HP: <%= creature.max_hp  + creature.temp_hp %></p>

    <div class="flex space-x-2 mt-2">
      <%= button_to "-",
            tracker_creature_update_health_path(tracker, creature, hp: creature.current_hp - 1),
            method: :put,
            form: { data: { turbo_frame: "hp_tracker" } },
            class: "px-3 py-1 bg-red-600 rounded-lg" %>

      <%= button_to "+",
            tracker_creature_update_health_path(tracker, creature, hp: creature.current_hp + 1),
            method: :put,
            form: { data: { turbo_frame: "hp_tracker" } },
            class: "px-3 py-1 bg-green-600 rounded-lg" %>
    </div>
  </div>
<% else %>
  <div class="p-4 bg-gray-700 rounded-2xl text-white">
    <h2 class="text-lg font-bold mb-2">Select a creature</h2>
    <p>Temp HP: -- </p>
    <p>Current HP: -- </p>
    <p>Max HP: -- </p>
  </div>
<% end %>
