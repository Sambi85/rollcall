<div>
  <div class="flex items-center justify-between w-full mb-6">
    <h1 class="text-3xl font-bold"><%= @tracker.name || "Nameless Encounter" %></h1>

    <a href="/dashboard" 
       class="space-x-1 text-sm font-medium text-gray-700 hover:text-gray-900">
      <svg xmlns="http://www.w3.org/2000/svg" 
         width="24" 
         height="24"
         viewBox="0 0 24 24" 
         fill="none" 
         stroke="white">
        <path d="M7 10L3 6l4-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  
  <!-- Carousel with spacing -->
  <div class="my-4 overflow-hidden bg-gray-800 rounded-2xl p-4">
    <div data-controller="carousel" class="overflow-hidden">
      <div data-carousel-target="viewport" class="overflow-hidden">
        <div class="flex space-x-2 px-2">
          <% @turn_order.each_with_index do |entity, index| %>
            <% 
              is_current = entity == @tracker.current_turn
              has_acted = @tracker.acted_this_round.include?(entity) rescue false
              is_special = entity.try(:special_event?) || false

              card_classes =
                if is_current
                  "min-w-[250px] bg-red-800 border-2 border-white text-white"
                elsif is_special
                  "min-w-[250px] bg-purple-700 text-white"
                elsif has_acted
                  "min-w-[250px] bg-gray-600 text-gray-300"
                else
                  "min-w-[250px] bg-gray-300 text-black"
                end
            %>

            <div class="<%= card_classes %> rounded-2xl shadow-lg p-4 flex-shrink-0 relative">
              <!-- Number label -->
              <div class="absolute top-2 left-2 bg-black bg-opacity-50 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold">
                <%= index + 1 %>
              </div>

              <h3 class="text-xl font-bold mb-2"><%= entity.name %></h3>
              <% if entity.respond_to?(:initiative) %>
                <p>Initiative: <%= entity.initiative || "Unknown" %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Round / Active Creature with spacing -->
  <div class="my-4 bg-gray-800 rounded-lg p-4 shadow-md">
    <p class="text-lg font-semibold text-white">
      Turn: <%= @tracker.current_turn_name %> | Round: <%= @tracker.round %>
    </p>
  </div>
</div>
