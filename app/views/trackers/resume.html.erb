<div>
  <div class="flex items-center justify-between w-full mb-6">
    <h1 class="text-3xl font-bold"><%= @tracker.name || "Nameless Encounter" %></h1>

    <a href="/dashboard" 
       class="space-x-1 text-sm font-medium text-gray-700 hover:text-gray-900">
      <svg xmlns="http://www.w3.org/2000/svg" 
         width="24" 
         height="24"
         viewBox="0 0 24 24" 
         fill="none" 
         stroke="white">
        <path d="M7 10L3 6l4-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <!-- Carousel of cards -->
  <div class="overflow-x-auto">
    <div class="flex space-x-4">
      <% @turn_order.each do |entity| %>
        <div class="min-w-[250px] bg-white rounded-2xl shadow-lg p-4 flex-shrink-0">
          <h3 class="text-xl font-bold mb-2"><%= entity.name %></h3>

          <% if entity.respond_to?(:initiative) %>
            <p class="text-gray-700">Initiative: <%= entity.initiative || "Unknown" %></p>
          <% end %>

          <% if entity.respond_to?(:effects) && entity.effects.any? %>
            <div class="mt-2">
              <h4 class="font-semibold">Effects:</h4>
              <ul class="list-disc list-inside text-sm">
                <% entity.effects.each do |effect| %>
                  <li><%= effect.name %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if entity.respond_to?(:abilities) && entity.abilities.any? %>
            <div class="mt-2">
              <h4 class="font-semibold">Abilities:</h4>
              <ul class="list-disc list-inside text-sm">
                <% entity.abilities.each do |ability| %>
                  <li><%= ability.name %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
      <!-- Current Round / Active Creature -->
  <div class="mb-4 bg-gray-800 rounded-lg p-4 shadow-md">
    <p class="text-lg font-semibold text-white">
      Turn: <%= @tracker.current_turn_name %> | Round: <%= @tracker.round %>
    </p>
  </div>

</div>
