<div>
  <div class="flex items-center justify-between w-full mb-6">
    <h1 class="text-3xl font-bold"><%= @tracker.name || "Nameless Encounter" %></h1>

    <a href="/dashboard" 
       class="space-x-1 text-sm font-medium text-gray-700 hover:text-gray-900">
      <svg xmlns="http://www.w3.org/2000/svg" 
         width="24" 
         height="24"
         viewBox="0 0 24 24" 
         fill="none" 
         stroke="white">
        <path d="M7 10L3 6l4-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  
  <!-- Carousel with spacing -->
  <div class="my-4 overflow-hidden bg-gray-800 rounded-2xl p-4">
    <div data-controller="carousel" class="overflow-hidden">
      <div data-carousel-target="viewport" class="overflow-hidden">
        <div class="flex space-x-2 px-2">
          <% @turn_order.each_with_index do |entity, index| %>
            <% 
              is_current = entity == @tracker.current_turn
              has_acted = @tracker.acted_this_round.include?(entity) rescue false
              is_special = entity.try(:special_event?) || false

              card_classes =
                if is_current
                  "min-w-[250px] bg-red-800 border-2 border-white text-white"
                elsif is_special
                  "min-w-[250px] bg-purple-700 text-white"
                elsif has_acted
                  "min-w-[250px] bg-gray-600 text-gray-300"
                else
                  "min-w-[250px] bg-gray-300 text-black"
                end
            %>

            <div class="<%= card_classes %> rounded-2xl shadow-lg p-4 flex-shrink-0 relative">
              <!-- Number label -->
              <div class="absolute top-2 left-2 bg-black bg-opacity-50 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold">
                <%= index + 1 %>
              </div>

              <h3 class="text-xl font-bold mb-2"><%= entity.name %></h3>
              <% if entity.respond_to?(:initiative) %>
                <p>Initiative: <%= entity.initiative || "Unknown" %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- CONDITION -->
  <% creature = @tracker.current_turn %>
  <% role = creature.try(:role) || "Creature" %>
  <% is_current_turn = creature.present? && creature == @tracker.current_turn %>

  <!-- Current Round -->
  <div class="my-4 rounded-lg p-4 shadow-md text-left 
              <%= is_current_turn ? 'bg-red-800 text-white' : 'bg-gray-800 text-white' %>">
    <p class="font-semibold">
      Round: <%= @tracker.round %>   |   Current Turn: <strong><%= creature.name %></strong>   |   Role: <%= role %>
    </p>
  </div>

  <!-- Creature Stats -->
  <% if creature.present? && creature.is_a?(Creature) %>
    <div class="mt-2 rounded-lg p-3 shadow-lg 
                <%= is_current_turn ? 'bg-red-900 text-white' : 'bg-gray-900 text-white' %>">
      <h3 class="text-lg font-bold mb-3"><%= creature.name %></h3>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
        <div class="<%= is_current_turn ? 'bg-red-800' : 'bg-gray-800' %> p-2 rounded-lg text-center">
          <p class="font-semibold">Initiative</p>
          <p><%= creature.initiative || "Unknown" %></p>
        </div>
  
        <div class="<%= is_current_turn ? 'bg-red-800' : 'bg-gray-800' %> p-2 rounded-lg text-center">
          <p class="font-semibold">HP</p>
          <p><%= creature.current_hp %> / <%= creature.max_hp %></p>
        </div>
  
        <div class="<%= is_current_turn ? 'bg-red-800' : 'bg-gray-800' %> p-2 rounded-lg text-center">
          <p class="font-semibold">AC</p>
          <p><%= creature.try(:ac) || "Unknown" %></p>
        </div>
  
        <div class="<%= is_current_turn ? 'bg-red-800' : 'bg-gray-800' %> p-2 rounded-lg text-center">
          <p class="font-semibold">Speed</p>
          <p><%= creature.try(:speed) ? "#{creature.speed} ft." : "Unknown" %></p>
        </div>
      </div>
    </div>
  <% end %>

</div>
